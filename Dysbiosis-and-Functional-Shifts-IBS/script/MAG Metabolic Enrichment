# ===============================================================
# MAG METABOLIC-MODULE ESTIMATION AND ENRICHMENT
# ===============================================================

# This analysis uses the group-specific genome/bin set before final
# dereplication: 94 HC and 127 IBS entries, 221 entries in total.

# group_specific_external_genomes.txt contains one annotated anvi'o contigs
# database per group-specific entry.

anvi-estimate-metabolism \
  -e group_specific_external_genomes.txt \
  -O MAG_metabolism

# MAG_metabolism_modules.txt is the default modules-mode output.
# Genome names in mag_groups.txt must match those in the modules table.

anvi-compute-metabolic-enrichment \
  -M MAG_metabolism_modules.txt \
  -G mag_groups.txt \
  -o MAG_metabolic_enrichment.tsv

# anvi'o applies a binomial generalized linear model with a logit link and the
# Rao test. P values were adjusted using the Benjamini-Hochberg method, and
# q < 0.05 was considered significant.
