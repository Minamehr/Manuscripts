#!/usr/bin/env bash
set -euo pipefail

# MAG METABOLIC-MODULE ESTIMATION AND ENRICHMENT
#
# This analysis uses the group-specific genome/bin set before final
# dereplication: 94 HC and 127 IBS entries, 221 entries in total.

EXTERNAL_GENOMES=${EXTERNAL_GENOMES:-group_specific_external_genomes.txt}
GROUPS=${GROUPS:-mag_groups.txt}
OUT_PREFIX=${OUT_PREFIX:-MAG_metabolism}
ENRICHMENT_OUT=${ENRICHMENT_OUT:-MAG_metabolic_enrichment.tsv}

# external-genomes file:
#   name    contigs_db_path
#
# groups file:
#   sample    group
#
# Genome names must match between the modules table and groups file.

anvi-estimate-metabolism \
  -e "$EXTERNAL_GENOMES" \
  --matrix-format \
  --include-metadata \
  -O "$OUT_PREFIX"

# Use the modules-mode output generated by anvi-estimate-metabolism.
# Replace the filename below with the exact modules output produced by the
# installed anvi'o version.
MODULES_FILE="${OUT_PREFIX}-modules.txt"

anvi-compute-metabolic-enrichment \
  -M "$MODULES_FILE" \
  -G "$GROUPS" \
  -o "$ENRICHMENT_OUT"

# Significance criterion used in the study:
#   BH-adjusted q < 0.05
#
# No additional enrichment-score or minimum-sample-count filter is applied.
