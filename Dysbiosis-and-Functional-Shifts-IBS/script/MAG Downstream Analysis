# ===============================================================
# DOWNSTREAM MAG ANALYSIS
# ===============================================================

#
# Input exported from Galaxy:
#   refined HC, IBS-C, IBS-D, and IBS-M bins after metaWRAP and CheckM

# --------- Step 1: anvi'o Databases and Genome Assessment ---------

mkdir -p MAG_contigs_databases
printf "name\tcontigs_db_path\n" > group_specific_external_genomes.txt

for group in HC IBSC IBSD IBSM; do
    for genome in Binning/${group}/refined_bins/*.fa; do
        name=${group}_$(basename "${genome%.fa}")
        db=MAG_contigs_databases/${name}.db

        anvi-gen-contigs-database -f "$genome" -o "$db" -n "$name"
        anvi-run-hmms -c "$db" --num-threads 8

        printf "%s\t%s\n" "$name" "$db" \
          >> group_specific_external_genomes.txt
    done
done

anvi-estimate-genome-completeness \
  -e group_specific_external_genomes.txt \
  -o group_specific_genome_completeness.tsv

# Genomes were manually inspected using the Bacteria_71 single-copy marker set.
# The retained group-specific set comprised 221 quality-filtered entries:
# 94 HC and 127 IBS, each with >=70% completeness and <=5% contamination.


# --------- Step 2: Cross-Group Dereplication ---------

anvi-compute-genome-similarity \
  -e group_specific_external_genomes.txt \
  --program fastANI \
  -o Genome_Similarity

anvi-dereplicate-genomes \
  --ani-dir Genome_Similarity \
  --similarity-threshold 0.99 \
  --representative-method Qscore \
  -o Dereplicated_MAGs

# Final output: 154 nonredundant quality-filtered MAGs.


# --------- Step 3: Taxonomy Assignment ---------

gtdbtk classify_wf \
  --genome_dir Dereplicated_MAGs/GENOMES \
  --out_dir GTDBTK_MAGs \
  --cpus 8


# --------- Step 4: Functional Annotation ---------

# COG, KOfam, Pfam, and CAZyme annotations were added to the MAG databases.
for db in MAG_contigs_databases/*.db; do
    anvi-run-ncbi-cogs -c "$db" --num-threads 8
    anvi-run-kegg-kofams -c "$db" --num-threads 8
    anvi-run-pfams -c "$db" --num-threads 8
    anvi-run-cazymes -c "$db" --num-threads 8
done


# --------- Step 5: Recruitment and Abundance ---------

# Host-filtered reads from every sample were recruited to the nonredundant MAG
# collection using BWA-MEM. The resulting sorted and indexed BAM files were
# profiled in anvi'o and used to obtain MAG abundance/recruitment summaries.


# --------- Step 6: Phylogenomics ---------

# nonredundant_external_genomes.txt lists the anvi'o contigs databases
# corresponding to the 154 nonredundant MAG representatives.

anvi-get-sequences-for-hmm-hits \
  -e nonredundant_external_genomes.txt \
  --hmm-source Bacteria_71 \
  --return-best-hit \
  --get-aa-sequences \
  -o Bacteria_71_proteins.faa

muscle -in Bacteria_71_proteins.faa \
  -out Bacteria_71_aligned.faa

anvi-gen-phylogenomic-tree \
  -f Bacteria_71_aligned.faa \
  -o Bacteria_71_tree.nwk
