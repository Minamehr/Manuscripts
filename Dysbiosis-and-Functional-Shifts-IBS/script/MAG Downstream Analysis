#!/usr/bin/env bash
set -euo pipefail

# DOWNSTREAM ANVI'O, DEREPLICATION, TAXONOMY, RECRUITMENT, AND PHYLOGENOMICS
#
# Input exported from Galaxy:
#   refined group-specific MAG FASTA files from HC, IBS-C, IBS-D, and IBS-M.

REFINED_BINS=${REFINED_BINS:-refined_group_bins}
OUT=${OUT:-MAG_Downstream}
THREADS=${THREADS:-8}

mkdir -p "$OUT"/{contigs_databases,dereplication,gtdbtk,recruitment,phylogenomics}

# 1. Build one anvi'o contigs database per refined MAG and run annotation.
: > "$OUT/external-genomes.txt"
printf "name\tcontigs_db_path\n" > "$OUT/external-genomes.txt"

for genome in "$REFINED_BINS"/*.fa; do
    name=$(basename "${genome%.fa}")
    db="$OUT/contigs_databases/${name}.db"

    anvi-gen-contigs-database \
      -f "$genome" \
      -o "$db" \
      -n "$name"

    anvi-run-hmms \
      -c "$db" \
      --num-threads "$THREADS"

    anvi-run-ncbi-cogs \
      -c "$db" \
      --num-threads "$THREADS"

    anvi-run-kegg-kofams \
      -c "$db" \
      --num-threads "$THREADS"

    anvi-run-pfams \
      -c "$db" \
      --num-threads "$THREADS"

    anvi-run-cazymes \
      -c "$db" \
      --num-threads "$THREADS"

    printf "%s\t%s\n" "$name" "$(realpath "$db")" \
      >> "$OUT/external-genomes.txt"
done

# 2. Estimate genome completeness using anvi'o HMM collections.
anvi-estimate-genome-completeness \
  -e "$OUT/external-genomes.txt" \
  -o "$OUT/genome-completeness.tsv"

# 3. Calculate pairwise similarity and dereplicate at 99% ANI.
anvi-compute-genome-similarity \
  -e "$OUT/external-genomes.txt" \
  --program fastANI \
  -o "$OUT/dereplication/fastANI"

anvi-dereplicate-genomes \
  --ani-dir "$OUT/dereplication/fastANI" \
  --similarity-threshold 0.99 \
  --representative-method Qscore \
  -o "$OUT/dereplication/nonredundant_MAGs"

# Final study output: 154 nonredundant quality-filtered MAGs.

# 4. Assign taxonomy with GTDB-Tk.
gtdbtk classify_wf \
  --genome_dir "$OUT/dereplication/nonredundant_MAGs/GENOMES" \
  --out_dir "$OUT/gtdbtk" \
  --cpus "$THREADS"

# 5. Recruitment and abundance analysis.
#
# Concatenate the 154 dereplicated MAG FASTA files and map every host-filtered
# sample to this reference. Sort and index one BAM per sample.
#
# Example:
# cat "$OUT/dereplication/nonredundant_MAGs/GENOMES"/*.fa \
#   > "$OUT/recruitment/nonredundant_MAGs.fasta"
#
# bwa index "$OUT/recruitment/nonredundant_MAGs.fasta"
#
# bwa mem -t "$THREADS" \
#   "$OUT/recruitment/nonredundant_MAGs.fasta" \
#   sample_R1.fastq.gz sample_R2.fastq.gz |
#   samtools sort -@ "$THREADS" -o "$OUT/recruitment/sample.sorted.bam"
#
# samtools index "$OUT/recruitment/sample.sorted.bam"
#
# Profile the BAM files with anvi'o and merge the profiles to export abundance,
# detection, mean coverage, coverage variability, and bin-percent recruitment.

# 6. Bacteria_71 phylogenomics.
anvi-get-sequences-for-hmm-hits \
  -e "$OUT/external-genomes.txt" \
  --hmm-source Bacteria_71 \
  --return-best-hit \
  --get-aa-sequences \
  -o "$OUT/phylogenomics/Bacteria_71_proteins.faa"

muscle \
  -align "$OUT/phylogenomics/Bacteria_71_proteins.faa" \
  -output "$OUT/phylogenomics/Bacteria_71_aligned.faa"

anvi-gen-phylogenomic-tree \
  -f "$OUT/phylogenomics/Bacteria_71_aligned.faa" \
  -o "$OUT/phylogenomics/Bacteria_71_tree.nwk"
