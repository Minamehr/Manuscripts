# ===============================================================
# GENE TAXONOMIC/FUNCTIONAL ANNOTATION AND ABUNDANCE ESTIMATION
# ===============================================================

#
# Inputs exported from the Galaxy gene-catalogue workflow:
#   Clustering/rep_seq.faa  representative protein catalogue
#   Clustering/rep_seq.fna  matching nucleotide gene catalogue
#   Clean_Reads/            host-filtered paired FASTQ files

# --------- Step 1: Taxonomic Annotation (UniProt TrEMBL) ---------

diamond blastp -d /path/to/uniprot_trembl.dmnd \
  -q Clustering/rep_seq.faa \
  -o Clustering/diamond_annotation.tsv \
  -f 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle \
  -k 1 -e 1e-5 -p 16


# --------- Step 2: Functional Annotation ---------

# KEGG annotation using KOBAS
kobas-annotate -i Clustering/rep_seq.faa \
  -t fasta:pro -s ko -o KOBAS_annotation.tsv

# COG annotation using eggNOG-mapper
emapper.py -i Clustering/rep_seq.faa \
  --output emapper_output --cpu 16 --itype proteins

# CAZyme annotation using dbCAN HMMs and HMMER
hmmscan --domtblout dbcan_out.domtblout \
  --cpu 16 /path/to/dbCAN-HMMdb-V8.txt \
  Clustering/rep_seq.faa > dbcan_out.txt

# Pfam domain annotation
hmmscan --domtblout pfam_out.domtblout \
  --cpu 16 /path/to/Pfam-A.hmm \
  Clustering/rep_seq.faa > pfam_out.txt

# ARG and virulence-factor annotation using PathoFact
python pathofact.py -i Clustering/rep_seq.faa \
  -o pathofact_output/ --threads 20


# --------- Step 3: Gene Abundance Estimation ---------

# Reads were mapped to the nucleotide gene catalogue.
mkdir -p GeneAbundance
bwa index Clustering/rep_seq.fna

for r1 in Clean_Reads/*_1_unmapped.fastq.gz; do
    sample=$(basename "${r1%_1_unmapped.fastq.gz}")
    r2=Clean_Reads/${sample}_2_unmapped.fastq.gz

    bwa mem Clustering/rep_seq.fna "$r1" "$r2" \
      > GeneAbundance/${sample}.sam

    # Samsum reports mapped fragments, FPKM, and TPM. The FPKM column from
    # each per-sample Samsum table was used for the final abundance matrix.
    samsum stats \
      -f Clustering/rep_seq.fna \
      -a GeneAbundance/${sample}.sam \
      -o GeneAbundance/${sample}_samsum.tsv
done

# Per-sample Samsum FPKM columns were merged by gene identifier and aggregated
# by taxonomic or functional annotation for downstream comparisons.
